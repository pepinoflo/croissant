    { "id": "l06.p.pour-aller-en-ville", "type": "phrase", "group": "Organiser", "fr": "Pour aller en ville, je préfère prendre le bus.", "en": "To go into town, I prefer to take the bus." },

    { "id": "l06.g.futur-proche", "type": "grammar", "title": "Le futur proche", "titleEn": "\"Going to\": plans and things about to happen",
      "body": "**aller** in the present + the **infinitive** of the verb.\n\nUse it for plans and for things that are going to happen soon.\n\nIn the negative, ne … pas goes around **aller**: je ne vais pas travailler.\n\nCompare: **le samedi**, je vais au cinéma (every Saturday, a habit) and **samedi**, je vais aller au cinéma (this Saturday, a plan).",
      "table": { "headers": ["", "aller", "+ infinitive"], "rows": [
        ["je", "vais", "sortir"],
        ["tu", "vas", "cuisiner"],
        ["il / elle / on", "va", "visiter une exposition"],
        ["nous", "allons", "prendre le train"],
        ["vous", "allez", "rencontrer des amis"],
        ["ils / elles", "vont", "aller au restaurant"]
      ] } },
    { "id": "l06.c.sortir-futur-proche", "type": "conjugation", "group": "Le futur proche", "verb": "sortir", "en": "to go out", "tense": "futur proche", "grammar": "l06.g.futur-proche",
      "forms": { "je": "vais sortir", "tu": "vas sortir", "il": "va sortir", "nous": "allons sortir", "vous": "allez sortir", "ils": "vont sortir" } },
    { "id": "l06.p.le-samedi", "type": "phrase", "group": "Le futur proche", "fr": "Le samedi, je vais au cinéma.", "en": "On Saturdays, I go to the cinema.", "note": "le samedi = every Saturday" },
    { "id": "l06.p.samedi-je-vais-aller", "type": "phrase", "group": "Le futur proche", "fr": "Samedi, je vais aller au cinéma.", "en": "This Saturday, I'm going to go to the cinema." },
    { "id": "l06.x.vais-regarder", "type": "cloze", "group": "Le futur proche", "fr": "Ce soir, je {{vais regarder}} un film.", "en": "Tonight, I'm going to watch a film.", "hint": "regarder", "distractors": ["va regarder", "vais regarde", "allons regarder"], "grammar": "l06.g.futur-proche" },
    { "id": "l06.x.allons-visiter", "type": "cloze", "group": "Le futur proche", "fr": "Demain, nous {{allons visiter}} une exposition.", "en": "Tomorrow, we are going to visit an exhibition.", "hint": "visiter", "distractors": ["vont visiter", "allons visitons", "allez visiter"], "grammar": "l06.g.futur-proche" },
    { "id": "l06.x.vas-sortir", "type": "cloze", "group": "Le futur proche", "fr": "Tu {{vas sortir}} avec tes amis samedi ?", "en": "Are you going to go out with your friends on Saturday?", "hint": "sortir", "distractors": ["va sortir", "vas sors", "vais sortir"], "grammar": "l06.g.futur-proche" },
    { "id": "l06.x.va-preparer", "type": "cloze", "group": "Le futur proche", "fr": "Elle {{va préparer}} le dîner ce soir.", "en": "She is going to make dinner tonight.", "hint": "préparer", "distractors": ["vas préparer", "va prépare", "vont préparer"], "grammar": "l06.g.futur-proche", "explain": "elle va — no s. The s is only for tu: tu vas." },
    { "id": "l06.x.allez-prendre", "type": "cloze", "group": "Le futur proche", "fr": "Vous {{allez prendre}} le train demain ?", "en": "Are you going to take the train tomorrow?", "hint": "prendre", "distractors": ["allons prendre", "allez prenez", "vont prendre"], "grammar": "l06.g.futur-proche" },
    { "id": "l06.x.vont-inviter", "type": "cloze", "group": "Le futur proche", "fr": "Ils {{vont inviter}} leurs amis chez eux.", "en": "They are going to invite their friends over.", "hint": "inviter", "distractors": ["va inviter", "vont invitent", "allons inviter"], "grammar": "l06.g.futur-proche" },
    { "id": "l06.x.on-va-decouvrir", "type": "cloze", "group": "Le futur proche", "fr": "On {{va découvrir}} un nouveau restaurant.", "en": "We are going to try out a new restaurant.", "hint": "découvrir", "distractors": ["vont découvrir", "vas découvrir", "allons découvrir"], "grammar": "l06.g.futur-proche", "explain": "on means \"we\" here, but the verb is conjugated like il / elle: on va." },
    { "id": "l06.x.ne-vais-pas-travailler", "type": "cloze", "group": "Le futur proche", "fr": "Ce week-end, je ne {{vais}} pas travailler.", "en": "This weekend, I'm not going to work.", "hint": "aller", "distractors": ["va", "vas", "aller"], "grammar": "l06.g.futur-proche" },

