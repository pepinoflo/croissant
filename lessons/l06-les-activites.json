    { "id": "l06.p.je-suis-occupee", "type": "phrase", "group": "Répondre", "fr": "Non, je suis occupée.", "en": "No, I'm busy.", "frAlt": ["Non, je suis occupé."], "note": "A woman writes occupée, a man occupé. They sound the same." },
