    { "id": "l10.s.mon-frere-habite-avec-sa-femme", "type": "sentence", "group": "À toi de parler", "fr": "Mon frère habite avec sa femme dans une grande maison.", "en": "My brother lives with his wife in a big house.", "frAlt": ["Mon frère [habite|vit] avec sa femme dans une grande maison."], "traps": ["son", "grand"], "grammar": "l10.g.possessifs" },
    { "id": "l10.s.nos-parents-retraite", "type": "sentence", "group": "À toi de parler", "fr": "Nos parents sont à la retraite.", "en": "Our parents are retired.", "frAlt": ["Nos parents sont [à la retraite|retraités]."], "traps": ["notre", "est"], "grammar": "l10.g.possessifs" },
    { "id": "l10.s.ou-sont-tes-cles", "type": "sentence", "group": "À toi de parler", "fr": "Où sont tes clés ?", "en": "Where are your keys?", "frAlt": ["Où sont [tes|vos] clés ?", "[Tes|Vos] clés sont où ?"], "traps": ["ta", "est"], "grammar": "l10.g.possessifs" },
    { "id": "l10.s.je-cherche-mon-sac", "type": "sentence", "group": "À toi de parler", "fr": "Je cherche mon sac et mon portefeuille.", "en": "I'm looking for my bag and my wallet.", "traps": ["ma", "mes"], "grammar": "l10.g.possessifs" },
    { "id": "l10.s.elle-range-ses-vetements", "type": "sentence", "group": "À toi de parler", "fr": "Elle range ses vêtements.", "en": "She is tidying her clothes.", "traps": ["sa", "son"], "grammar": "l10.g.possessifs" },
    { "id": "l10.s.leur-maison-pres-de-la-mer", "type": "sentence", "group": "À toi de parler", "fr": "Leur maison est près de la mer.", "en": "Their house is near the sea.", "traps": ["leurs", "sa"], "grammar": "l10.g.possessifs" },
    { "id": "l10.s.mon-amie-comptable", "type": "sentence", "group": "À toi de parler", "fr": "Mon amie est comptable dans une compagnie d'assurance.", "en": "My friend works as an accountant in an insurance company.", "frAlt": ["[Mon amie|Mon ami] [est comptable|travaille comme comptable] dans une compagnie d'assurance."], "traps": ["ma", "un"], "grammar": "l10.g.possessifs", "note": "mon amie: « mon » before a vowel, even for a feminine word." },
    { "id": "l10.s.quel-est-ton-repas-prefere", "type": "sentence", "group": "À toi de parler", "fr": "Quel est ton repas préféré ?", "en": "What is your favourite meal?", "frAlt": ["Quel est [ton|votre] repas préféré ?", "C'est quoi, ton repas préféré ?"], "traps": ["quelle", "ta"] },
    { "id": "l10.s.on-retrouve-nos-amis", "type": "sentence", "group": "À toi de parler", "fr": "On retrouve nos amis quelques fois par semaine.", "en": "We meet up with our friends a few times a week.", "frAlt": ["[On retrouve|Nous retrouvons] nos [amis|amies] quelques fois par semaine."], "traps": ["notre", "leurs"], "grammar": "l10.g.possessifs" },
    { "id": "l10.s.nos-souvenirs-precieux", "type": "sentence", "group": "À toi de parler", "fr": "Nos souvenirs de voyage sont très précieux.", "en": "Our travel memories are very precious.", "traps": ["notre", "précieuse"], "grammar": "l10.g.possessifs" },
    { "id": "l10.s.sa-soeur-s-appelle-julie", "type": "sentence", "group": "À toi de parler", "fr": "Sa sœur s'appelle Julie.", "en": "His sister's name is Julie.", "traps": ["son", "ses"], "grammar": "l10.g.possessifs", "note": "sa sœur = his OR her sister: the possessive agrees with sœur." },
    { "id": "l10.s.cuisine-epicee-pas-mon-frere", "type": "sentence", "group": "À toi de parler", "fr": "J'aime la cuisine épicée, mais pas mon frère.", "en": "I like spicy food, but my brother doesn't.", "frAlt": ["J'aime la [cuisine épicée|nourriture épicée], mais [pas mon frère|mon frère non|mon frère n'aime pas ça]."], "traps": ["épicé", "ma"] },
    { "id": "l10.s.tu-aimes-ton-nouvel-appartement", "type": "sentence", "group": "À toi de parler", "fr": "Tu aimes ton nouvel appartement ?", "en": "Do you like your new flat?", "frAlt": ["[Tu aimes|Est-ce que tu aimes|Aimes-tu] ton nouvel appartement ?", "[Vous aimez|Est-ce que vous aimez|Aimez-vous] votre nouvel appartement ?"], "traps": ["nouveau", "ta"], "note": "nouveau → nouvel before a vowel." },
    { "id": "l10.t.elle-range-ses-affaires", "type": "transform", "group": "Transformer", "task": "Mets la phrase avec « elle ».", "taskEn": "Put the sentence with « elle ».", "from": "Je range mes affaires.", "fr": "Elle range ses affaires.", "en": "She tidies her things.", "traps": ["sa", "ranges"], "grammar": "l10.g.possessifs" },
    { "id": "l10.t.nous-preparons-notre-repas", "type": "transform", "group": "Transformer", "task": "Mets la phrase avec « nous ».", "taskEn": "Put the sentence with « nous ».", "from": "Je prépare mon repas.", "fr": "Nous préparons notre repas.", "en": "We prepare our meal.", "traps": ["nos", "préparez"], "grammar": "l10.g.possessifs" },
    { "id": "l10.t.ils-visitent-leur-famille", "type": "transform", "group": "Transformer", "task": "Mets la phrase avec « ils ».", "taskEn": "Put the sentence with « ils ».", "from": "Il visite sa famille.", "fr": "Ils visitent leur famille.", "en": "They visit their family.", "traps": ["leurs", "visite"], "grammar": "l10.g.possessifs" },
    { "id": "l10.t.vous-cherchez-vos-cles", "type": "transform", "group": "Transformer", "task": "Mets la phrase avec « vous ».", "taskEn": "Put the sentence with « vous ».", "from": "Tu cherches tes clés.", "fr": "Vous cherchez vos clés.", "en": "You are looking for your keys.", "traps": ["votre", "cherches"], "grammar": "l10.g.possessifs" },
    { "id": "l10.t.tu-aimes-ta-maison", "type": "transform", "group": "Transformer", "task": "Mets la phrase avec « tu ».", "taskEn": "Put the sentence with « tu ».", "from": "J'aime ma maison.", "fr": "Tu aimes ta maison.", "en": "You like your house.", "traps": ["ton", "aime"], "grammar": "l10.g.possessifs" },
    { "id": "l10.q.parle-moi-de-ta-famille", "type": "question", "group": "À toi de répondre", "fr": "Parle-moi de ta famille.", "en": "Tell me about your family.", "hint": "mon père, ma mère, mes parents, son / sa / ses…", "models": ["Mes parents sont à la retraite. J'ai un frère, il habite avec sa femme.", "Ma famille habite loin. Je téléphone à ma mère quelques fois par semaine."], "grammar": "l10.g.possessifs" },
    { "id": "l10.q.ton-plat-prefere", "type": "question", "group": "À toi de répondre", "fr": "Quel est ton plat préféré ?", "en": "What is your favourite dish?", "hint": "Mon plat préféré, c'est…", "models": ["Mon plat préféré, c'est le ragoût de bœuf de ma mère.", "J'aime beaucoup la cuisine asiatique, surtout les plats épicés."] },
    { "id": "l10.q.objet-precieux", "type": "question", "group": "À toi de répondre", "fr": "Quel est l'objet le plus précieux pour toi ? Pourquoi ?", "en": "What is the most precious object to you? Why?", "hint": "C'est mon / ma…, parce que…", "models": ["C'est un cadre photo avec une photo de mes parents.", "Mes souvenirs de voyage sont très précieux pour moi."] }
  ]
