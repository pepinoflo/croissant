    { "id": "l10.v.prefere", "type": "vocab", "group": "Ce qui compte pour nous", "fr": "préféré", "en": "favourite", "pos": "adj", "note": "Feminine: préférée." },
    { "id": "l10.p.la-cuisine-asiatique", "type": "phrase", "group": "Ce qui compte pour nous", "fr": "J'aime la cuisine asiatique.", "en": "I like Asian food." },
