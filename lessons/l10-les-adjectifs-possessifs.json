{
  "schema": 1,
  "id": "l10-les-adjectifs-possessifs",
  "order": 10,
  "title": "Les adjectifs possessifs",
  "titleEn": "My, your, his, her: possessives and family",
  "emoji": "👨‍👩‍👧",
  "summary": "Mon, ma, mes and the rest of the possessives, with the vocabulary to talk about your family, your home and what matters to you.",
  "items": [
    { "id": "l10.g.possessifs", "type": "grammar", "title": "Les adjectifs possessifs", "titleEn": "Saying who something belongs to",
      "body": "The possessive agrees with the **thing owned**, not with the owner: **son** frère can be his brother or her brother.\n\nBefore a feminine word that starts with a **vowel**, use **mon, ton, son** instead of ma, ta, sa: mon amie, son école.\n\n**leur** takes an s only when the thing owned is plural: leur maison, leurs amis.",
      "table": { "headers": ["Owner", "Masculine", "Feminine", "Plural"], "rows": [
        ["je", "mon", "ma", "mes"],
        ["tu", "ton", "ta", "tes"],
        ["il / elle", "son", "sa", "ses"],
        ["nous", "notre", "notre", "nos"],
        ["vous", "votre", "votre", "vos"],
        ["ils / elles", "leur", "leur", "leurs"]
      ] },
      "examples": [
        { "fr": "C'est mon téléphone.", "en": "It's my phone." },
        { "fr": "C'est ma voiture.", "en": "It's my car." },
        { "fr": "Voici son frère.", "en": "This is his (or her) brother." }
      ] },

    { "id": "l10.v.mere", "type": "vocab", "group": "La famille", "fr": "mère", "en": "mother", "pos": "noun", "gender": "f", "article": "la", "emoji": "👩" },
    { "id": "l10.v.pere", "type": "vocab", "group": "La famille", "fr": "père", "en": "father", "pos": "noun", "gender": "m", "article": "le", "emoji": "👨" },
    { "id": "l10.v.frere", "type": "vocab", "group": "La famille", "fr": "frère", "en": "brother", "pos": "noun", "gender": "m", "article": "le", "emoji": "👦" },
    { "id": "l10.v.soeur", "type": "vocab", "group": "La famille", "fr": "sœur", "en": "sister", "pos": "noun", "gender": "f", "article": "la", "emoji": "👧" },
    { "id": "l10.v.parents", "type": "vocab", "group": "La famille", "fr": "parents", "en": "parents", "pos": "noun", "gender": "m", "plural": true, "article": "les" },
    { "id": "l10.v.famille", "type": "vocab", "group": "La famille", "fr": "famille", "en": "family", "pos": "noun", "gender": "f", "article": "la", "emoji": "👨‍👩‍👧" },
    { "id": "l10.v.ami", "type": "vocab", "group": "La famille", "fr": "ami", "en": "friend", "pos": "noun", "gender": "m", "frAlt": ["amie"], "note": "For a woman: une amie — and \"my friend\" is mon amie, because of the vowel." },

    { "id": "l10.x.ma-mere", "type": "cloze", "group": "Compléter", "fr": "Je téléphone à {{ma}} mère.", "en": "I phone my mother.", "distractors": ["mon", "mes", "ton"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.ton-travail", "type": "cloze", "group": "Compléter", "fr": "Tu aimes {{ton}} travail ?", "en": "Do you like your job?", "distractors": ["ta", "tes", "sa"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.ses-cles", "type": "cloze", "group": "Compléter", "fr": "Il cherche {{ses}} clés.", "en": "He is looking for his keys.", "distractors": ["son", "sa", "leur"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.ses-parents", "type": "cloze", "group": "Compléter", "fr": "Elle habite avec {{ses}} parents.", "en": "She lives with her parents.", "distractors": ["son", "sa", "leur"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.notre-diner", "type": "cloze", "group": "Compléter", "fr": "Nous préparons {{notre}} dîner.", "en": "We are making our dinner.", "distractors": ["nos", "ma", "ses"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.votre-appartement", "type": "cloze", "group": "Compléter", "fr": "Vous aimez {{votre}} appartement ?", "en": "Do you like your flat?", "distractors": ["vos", "ta", "mes"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.leur-famille", "type": "cloze", "group": "Compléter", "fr": "Ils visitent {{leur}} famille.", "en": "They visit their family.", "distractors": ["leurs", "son", "ses"], "grammar": "l10.g.possessifs", "explain": "One family: leur, without s." },
    { "id": "l10.x.mon-sac", "type": "cloze", "group": "Compléter", "fr": "Je prends {{mon}} sac.", "en": "I take my bag.", "accept": ["ton"], "distractors": ["ma", "mes", "ta"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.son-amie", "type": "cloze", "group": "Compléter", "fr": "Elle parle avec {{son}} amie.", "en": "She is talking with her friend.", "distractors": ["sa", "ses", "ma"], "grammar": "l10.g.possessifs", "explain": "amie is feminine but starts with a vowel: son amie." },
    { "id": "l10.x.tes-vetements", "type": "cloze", "group": "Compléter", "fr": "Tu ranges {{tes}} vêtements.", "en": "You put away your clothes.", "distractors": ["ton", "ta", "leur"], "grammar": "l10.g.possessifs" },

    { "id": "l10.v.appartement", "type": "vocab", "group": "À la maison", "fr": "appartement", "en": "flat, apartment", "pos": "noun", "gender": "m", "emoji": "🏢" },
    { "id": "l10.v.maison", "type": "vocab", "group": "À la maison", "fr": "maison", "en": "house", "pos": "noun", "gender": "f", "emoji": "🏠" },
    { "id": "l10.v.voiture", "type": "vocab", "group": "À la maison", "fr": "voiture", "en": "car", "pos": "noun", "gender": "f", "emoji": "🚗" },
    { "id": "l10.v.sac", "type": "vocab", "group": "À la maison", "fr": "sac", "en": "bag", "pos": "noun", "gender": "m", "emoji": "👜" },
    { "id": "l10.v.vetements", "type": "vocab", "group": "À la maison", "fr": "vêtements", "en": "clothes", "pos": "noun", "gender": "m", "plural": true, "emoji": "👕" },
    { "id": "l10.v.affaires", "type": "vocab", "group": "À la maison", "fr": "affaires", "en": "belongings, things", "pos": "noun", "gender": "f", "plural": true, "article": "les" },
    { "id": "l10.v.repas", "type": "vocab", "group": "À la maison", "fr": "repas", "en": "meal", "pos": "noun", "gender": "m" },
    { "id": "l10.v.ranger", "type": "vocab", "group": "À la maison", "fr": "ranger", "en": "to tidy, to put away", "pos": "verb" },
    { "id": "l10.v.chercher", "type": "vocab", "group": "À la maison", "fr": "chercher", "en": "to look for", "pos": "verb", "emoji": "🔎" },
    { "id": "l10.v.retrouver", "type": "vocab", "group": "À la maison", "fr": "retrouver", "en": "to meet up with, to find again", "pos": "verb" },

    { "id": "l10.x.sa-television", "type": "cloze", "group": "Transformer", "fr": "Je regarde ma télévision. → Il regarde {{sa}} télévision.", "en": "He watches his television.", "distractors": ["son", "ses", "ma"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.elle-ses-parents", "type": "cloze", "group": "Transformer", "fr": "Tu appelles tes parents. → Elle appelle {{ses}} parents.", "en": "She calls her parents.", "distractors": ["tes", "son", "leurs"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.leur-repas", "type": "cloze", "group": "Transformer", "fr": "Nous préparons notre repas. → Ils préparent {{leur}} repas.", "en": "They make their meal.", "distractors": ["leurs", "son", "notre"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.elles-leur-famille", "type": "cloze", "group": "Transformer", "fr": "Elle visite sa famille. → Elles visitent {{leur}} famille.", "en": "They visit their family.", "distractors": ["leurs", "sa", "ses"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.tes-affaires", "type": "cloze", "group": "Transformer", "fr": "Vous rangez vos affaires. → Tu ranges {{tes}} affaires.", "en": "You put away your things.", "distractors": ["vos", "ton", "ta"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.notre-maison", "type": "cloze", "group": "Transformer", "fr": "Ils aiment leur maison. → Nous aimons {{notre}} maison.", "en": "We love our house.", "distractors": ["nos", "leur", "votre"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.tes-amis", "type": "cloze", "group": "Transformer", "fr": "Je retrouve mes amis. → Tu retrouves {{tes}} amis.", "en": "You meet up with your friends.", "distractors": ["mes", "ton", "ta"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.notre-portefeuille", "type": "cloze", "group": "Transformer", "fr": "Il cherche son portefeuille. → Nous cherchons {{notre}} portefeuille.", "en": "We are looking for our wallet.", "distractors": ["nos", "son", "votre"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.nos-parents", "type": "cloze", "group": "Transformer", "fr": "Nous visitons {{nos}} parents.", "en": "We visit our parents.", "distractors": ["notre", "mon", "sa"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.mon-frere", "type": "cloze", "group": "Transformer", "fr": "Je retrouve {{mon}} frère.", "en": "I meet up with my brother.", "distractors": ["ma", "mes", "sa"], "grammar": "l10.g.possessifs" },
    { "id": "l10.x.sa-soeur", "type": "cloze", "group": "Transformer", "fr": "Il parle avec {{sa}} sœur.", "en": "He is talking with his sister.", "distractors": ["son", "ses", "mon"], "grammar": "l10.g.possessifs" },

    { "id": "l10.p.quelques-fois-par-semaine", "type": "phrase", "group": "Parler de sa famille", "fr": "quelques fois par semaine", "en": "a few times a week" },
