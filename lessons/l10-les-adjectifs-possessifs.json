    { "id": "l10.p.a-la-retraite", "type": "phrase", "group": "Parler de sa famille", "fr": "Mes parents sont à la retraite.", "en": "My parents are retired.", "note": "à la retraite = retired" },
    { "id": "l10.v.comptable", "type": "vocab", "group": "Parler de sa famille", "fr": "comptable", "en": "accountant", "pos": "noun", "gender": "mf" },
    { "id": "l10.v.compagnie-d-assurance", "type": "vocab", "group": "Parler de sa famille", "fr": "compagnie d'assurance", "en": "insurance company", "pos": "noun", "gender": "f", "frAlt": ["compagnie d'assurances"] },
    { "id": "l10.v.chef-d-entreprise", "type": "vocab", "group": "Parler de sa famille", "fr": "chef d'entreprise", "en": "business owner", "pos": "noun", "gender": "m", "frAlt": ["entrepreneur"], "note": "Also: un entrepreneur." },
    { "id": "l10.v.gentillesse", "type": "vocab", "group": "Parler de sa famille", "fr": "gentillesse", "en": "kindness", "pos": "noun", "gender": "f", "article": "la" },
    { "id": "l10.v.patience", "type": "vocab", "group": "Parler de sa famille", "fr": "patience", "en": "patience", "pos": "noun", "gender": "f", "article": "la" },
    { "id": "l10.v.cuisine", "type": "vocab", "group": "Parler de sa famille", "fr": "cuisine", "en": "cooking, kitchen", "pos": "noun", "gender": "f", "article": "la", "example": { "fr": "J'aime sa cuisine.", "en": "I love her cooking." } },
    { "id": "l10.v.passion", "type": "vocab", "group": "Parler de sa famille", "fr": "passion", "en": "passion", "pos": "noun", "gender": "f", "article": "la" },
    { "id": "l10.p.on-ne-voit-pas-nos-amis", "type": "phrase", "group": "Parler de sa famille", "fr": "On ne voit pas nos amis très souvent.", "en": "We don't see our friends very often.", "frAlt": ["On ne voit pas ses amis très souvent."] },

    { "id": "l10.p.on-veut-demenager", "type": "phrase", "group": "Ce qui compte pour nous", "fr": "On veut déménager pour quelques années.", "en": "We want to move for a few years.", "frAlt": ["Nous voulons déménager pour quelques années."] },
    { "id": "l10.p.on-est-contents", "type": "phrase", "group": "Ce qui compte pour nous", "fr": "On est contents.", "en": "We are happy.", "frAlt": ["On est heureux.", "Nous sommes contents.", "Nous sommes heureux."] },
    { "id": "l10.v.precieux", "type": "vocab", "group": "Ce qui compte pour nous", "fr": "précieux", "en": "precious", "pos": "adj", "emoji": "💎", "note": "Feminine: précieuse." },
    { "id": "l10.v.souvenir", "type": "vocab", "group": "Ce qui compte pour nous", "fr": "souvenir", "en": "memory, souvenir", "pos": "noun", "gender": "m", "example": { "fr": "nos souvenirs de voyage", "en": "our travel memories" } },
    { "id": "l10.p.nos-souvenirs-de-voyage", "type": "phrase", "group": "Ce qui compte pour nous", "fr": "nos souvenirs de voyage", "en": "our travel memories" },
