    { "id": "l07.v.hotel-de-ville", "type": "vocab", "group": "En voyage", "fr": "hôtel de ville", "en": "town hall", "pos": "noun", "gender": "m", "article": "l'", "note": "Not a hotel: it is where the mayor works." },
