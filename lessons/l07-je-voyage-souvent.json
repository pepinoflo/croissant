    { "id": "l07.g.present", "type": "grammar", "title": "Le présent", "titleEn": "Present tense endings",
      "body": "Verbs in **-er** (voyager, visiter, aimer, arriver) all take the same endings. The endings -e, -es, -e and -ent are silent, so four of the six forms sound the same.\n\n**nous voyageons**, **nous mangeons**: verbs in -ger keep an e before -ons.\n\n**préférer**: the second é becomes è when the ending is silent — je préfère, but nous préférons.\n\n**prendre**, **faire**, **mettre** and **aller** are irregular and have to be learned.",
      "table": { "headers": ["", "voyager", "prendre", "faire"], "rows": [
        ["je", "voyage", "prends", "fais"],
        ["tu", "voyages", "prends", "fais"],
        ["il / elle / on", "voyage", "prend", "fait"],
        ["nous", "voyageons", "prenons", "faisons"],
        ["vous", "voyagez", "prenez", "faites"],
        ["ils / elles", "voyagent", "prennent", "font"]
      ] } },
    { "id": "l07.c.voyager-present", "type": "conjugation", "group": "Le présent", "verb": "voyager", "en": "to travel", "tense": "présent", "grammar": "l07.g.present",
      "forms": { "je": "voyage", "tu": "voyages", "il": "voyage", "nous": "voyageons", "vous": "voyagez", "ils": "voyagent" },
      "note": "nous voyageons keeps its e." },
    { "id": "l07.c.preferer-present", "type": "conjugation", "group": "Le présent", "verb": "préférer", "en": "to prefer", "tense": "présent", "grammar": "l07.g.present",
      "forms": { "je": "préfère", "tu": "préfères", "il": "préfère", "nous": "préférons", "vous": "préférez", "ils": "préfèrent" },
      "note": "é becomes è except with nous and vous." },
    { "id": "l07.c.prendre-present", "type": "conjugation", "group": "Le présent", "verb": "prendre", "en": "to take", "tense": "présent", "grammar": "l07.g.present",
      "forms": { "je": "prends", "tu": "prends", "il": "prend", "nous": "prenons", "vous": "prenez", "ils": "prennent" } },
    { "id": "l07.c.faire-present", "type": "conjugation", "group": "Le présent", "verb": "faire", "en": "to do, to make", "tense": "présent", "grammar": "l07.g.present",
      "forms": { "je": "fais", "tu": "fais", "il": "fait", "nous": "faisons", "vous": "faites", "ils": "font" } },

    { "id": "l07.x.je-voyage", "type": "cloze", "group": "Le présent", "fr": "Je {{voyage}} souvent en été.", "en": "I often travel in summer.", "hint": "voyager", "distractors": ["voyages", "voyagent", "voyager"], "grammar": "l07.g.present" },
    { "id": "l07.x.tu-preferes", "type": "cloze", "group": "Le présent", "fr": "Tu {{préfères}} l'avion ou le train ?", "en": "Do you prefer the plane or the train?", "hint": "préférer", "distractors": ["préfère", "préférez", "préférer"], "grammar": "l07.g.present", "explain": "tu préfères: grave accent on the second e." },
    { "id": "l07.x.nous-preparons", "type": "cloze", "group": "Le présent", "fr": "Nous {{préparons}} notre valise la veille du départ.", "en": "We pack our suitcase the day before leaving.", "hint": "préparer", "distractors": ["préparez", "préparent", "prépare"], "grammar": "l07.g.present" },
    { "id": "l07.x.elle-prend", "type": "cloze", "group": "Le présent", "fr": "Elle {{prend}} beaucoup de photos en voyage.", "en": "She takes a lot of photos when travelling.", "hint": "prendre", "distractors": ["prends", "prennent", "prenez"], "grammar": "l07.g.present" },
    { "id": "l07.x.vous-visitez", "type": "cloze", "group": "Le présent", "fr": "Vous {{visitez}} souvent des musées ?", "en": "Do you often visit museums?", "hint": "visiter", "distractors": ["visitons", "visitent", "visites"], "grammar": "l07.g.present" },
    { "id": "l07.x.ils-mangent", "type": "cloze", "group": "Le présent", "fr": "Ils {{mangent}} au restaurant pendant les vacances.", "en": "They eat at restaurants during the holidays.", "hint": "manger", "distractors": ["mange", "mangez", "mangeons"], "grammar": "l07.g.present" },
    { "id": "l07.x.je-passe", "type": "cloze", "group": "Le présent", "fr": "Je {{passe}} mes vacances en famille.", "en": "I spend my holidays with my family.", "hint": "passer", "distractors": ["passes", "passent", "passons"], "grammar": "l07.g.present" },
    { "id": "l07.x.tu-mets", "type": "cloze", "group": "Le présent", "fr": "Tu {{mets}} quoi dans ta valise ?", "en": "What do you put in your suitcase?", "hint": "mettre", "distractors": ["met", "mettez", "mettent"], "grammar": "l07.g.present" },
    { "id": "l07.x.nous-arrivons", "type": "cloze", "group": "Le présent", "fr": "Nous {{arrivons}} à l'hôtel vers 18 heures.", "en": "We arrive at the hotel around 6 p.m.", "hint": "arriver", "distractors": ["arrivez", "arrivent", "arrive"], "grammar": "l07.g.present" },
    { "id": "l07.x.elle-aime", "type": "cloze", "group": "Le présent", "fr": "Elle {{aime}} découvrir de nouveaux pays.", "en": "She likes discovering new countries.", "hint": "aimer", "distractors": ["aimes", "aiment", "aimer"], "grammar": "l07.g.present" },

