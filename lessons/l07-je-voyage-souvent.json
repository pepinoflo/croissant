    { "id": "l07.p.ca-m-est-egal", "type": "phrase", "group": "Donner son avis", "fr": "Ça m'est égal.", "en": "I don't mind either way." },
    { "id": "l07.p.je-m-en-fous", "type": "phrase", "group": "Donner son avis", "fr": "Je m'en fous.", "en": "I couldn't care less. (rude)", "register": "informal", "frAlt": ["Je m'en fiche."], "note": "Rude: only with close friends. The gentler version is \"Je m'en fiche\"." },
