  "title": "Je voyage souvent en été",
  "titleEn": "Travel habits and the present tense",
  "emoji": "✈️",
  "summary": "Talking about how you like to travel, giving your opinion, and the present tense of voyager, préférer, prendre and faire.",
  "items": [
    { "id": "l07.v.ete", "type": "vocab", "group": "En voyage", "fr": "été", "en": "summer", "pos": "noun", "gender": "m", "article": "l'", "emoji": "☀️", "note": "en été = in summer" },
    { "id": "l07.v.avion", "type": "vocab", "group": "En voyage", "fr": "avion", "en": "plane", "pos": "noun", "gender": "m", "emoji": "✈️" },
    { "id": "l07.v.train", "type": "vocab", "group": "En voyage", "fr": "train", "en": "train", "pos": "noun", "gender": "m", "emoji": "🚆" },
