    { "id": "l07.s.je-ne-conduis-pas", "type": "sentence", "group": "À toi de parler", "fr": "Je ne conduis pas, donc je prends le train.", "en": "I don't drive, so I take the train.", "frAlt": ["Je ne conduis pas, [donc|alors] je prends le train."], "traps": ["conduit", "prend"], "grammar": "l07.g.present" },
    { "id": "l07.s.sejours-courts-avion-efficace", "type": "sentence", "group": "À toi de parler", "fr": "Pour les séjours courts, l'avion est plus efficace.", "en": "For short stays, the plane is more efficient.", "frAlt": ["Pour les [séjours courts|courts séjours], l'avion est plus efficace.", "L'avion est plus efficace pour les [séjours courts|courts séjours]."], "traps": ["le", "court"] },
    { "id": "l07.s.ca-m-est-egal-j-aime-les-deux", "type": "sentence", "group": "À toi de parler", "fr": "Ça m'est égal, j'aime les deux.", "en": "I don't mind, I like both.", "traps": ["tous", "est"] },
    { "id": "l07.s.tu-preferes-montagne-ou-mer", "type": "sentence", "group": "À toi de parler", "fr": "Tu préfères la montagne ou la mer ?", "en": "Do you prefer the mountains or the sea?", "frAlt": ["[Tu préfères|Est-ce que tu préfères|Préfères-tu] la montagne ou la mer ?", "[Vous préférez|Est-ce que vous préférez|Préférez-vous] la montagne ou la mer ?"], "traps": ["préfère", "le"], "grammar": "l07.g.present" },
    { "id": "l07.s.ils-arrivent-hotel-vers-18h", "type": "sentence", "group": "À toi de parler", "fr": "Ils arrivent à l'hôtel vers dix-huit heures.", "en": "They arrive at the hotel around 6 p.m.", "frAlt": ["Ils arrivent à l'hôtel vers [dix-huit heures|18 heures|18h|six heures du soir]."], "traps": ["arrive", "au"], "grammar": "l07.g.present" },
    { "id": "l07.s.voir-les-monuments-en-vrai", "type": "sentence", "group": "À toi de parler", "fr": "Je veux voir les monuments en vrai.", "en": "I want to see the monuments in real life.", "frAlt": ["Je veux voir les monuments pour de vrai."], "traps": ["veut", "vu"] },
    { "id": "l07.s.j-ai-entendu-que-le-nord", "type": "sentence", "group": "À toi de parler", "fr": "J'ai entendu que le nord était plus joli.", "en": "I heard that the north was prettier.", "frAlt": ["J'ai entendu [dire |]que le nord était plus joli."], "traps": ["jolie", "est"] },
    { "id": "l07.s.vous-visitez-des-musees", "type": "sentence", "group": "À toi de parler", "fr": "Vous visitez souvent des musées quand vous voyagez ?", "en": "Do you often visit museums when you travel?", "frAlt": ["[Vous visitez|Est-ce que vous visitez|Visitez-vous] souvent des musées quand vous voyagez ?", "[Tu visites|Est-ce que tu visites|Visites-tu] souvent des musées quand tu voyages ?"], "traps": ["visitons", "voyagent"], "grammar": "l07.g.present" },
    { "id": "l07.t.nous-prenons-l-avion", "type": "transform", "group": "Transformer", "task": "Mets la phrase avec « nous ».", "taskEn": "Put the sentence with « nous ».", "from": "Je prends l'avion.", "fr": "Nous prenons l'avion.", "en": "We take the plane.", "traps": ["prennent", "prendons"], "grammar": "l07.g.present" },
    { "id": "l07.t.ils-font-leur-valise", "type": "transform", "group": "Transformer", "task": "Mets la phrase avec « ils ».", "taskEn": "Put the sentence with « ils ».", "from": "Il fait sa valise.", "fr": "Ils font leur valise.", "en": "They pack their suitcase.", "frAlt": ["Ils font leurs valises."], "traps": ["fait", "sa"], "grammar": "l07.g.present" },
    { "id": "l07.t.vous-preferez-le-train", "type": "transform", "group": "Transformer", "task": "Mets la phrase avec « vous ».", "taskEn": "Put the sentence with « vous ».", "from": "Tu préfères le train ?", "fr": "Vous préférez le train ?", "en": "Do you prefer the train?", "traps": ["préférer", "préfèrez"], "grammar": "l07.g.present" },
    { "id": "l07.t.negatif-voyage-ete", "type": "transform", "group": "Transformer", "task": "Mets la phrase à la forme négative.", "taskEn": "Make the sentence negative.", "from": "Je voyage souvent en été.", "fr": "Je ne voyage pas souvent en été.", "en": "I don't travel often in summer.", "traps": ["non"], "grammar": "l02.g.negation" },
    { "id": "l07.t.je-prends-des-photos", "type": "transform", "group": "Transformer", "task": "Mets la phrase avec « je ».", "taskEn": "Put the sentence with « je ».", "from": "Elles prennent beaucoup de photos.", "fr": "Je prends beaucoup de photos.", "en": "I take a lot of photos.", "traps": ["prend", "prenne"], "grammar": "l07.g.present" },
    { "id": "l07.q.train-ou-avion", "type": "question", "group": "À toi de répondre", "fr": "Tu préfères voyager en train ou en avion ? Pourquoi ?", "en": "Do you prefer travelling by train or by plane? Why?", "hint": "Je préfère…, parce que c'est plus…", "models": ["Je préfère le train, parce que c'est plus confortable et je peux me reposer.", "Pour les longs voyages, je préfère l'avion : c'est plus rapide."] },
    { "id": "l07.q.dans-ta-valise", "type": "question", "group": "À toi de répondre", "fr": "Qu'est-ce que tu mets toujours dans ta valise ?", "en": "What do you always put in your suitcase?", "hint": "Je mets toujours…", "models": ["Je mets toujours mon chargeur, un livre et des vêtements chauds.", "Je prends toujours mon sac à dos et mes écouteurs."] },
    { "id": "l07.q.tu-voyages-souvent", "type": "question", "group": "À toi de répondre", "fr": "Tu voyages souvent ? Où est-ce que tu aimes aller ?", "en": "Do you travel often? Where do you like to go?", "hint": "Je voyage… fois par…, j'aime aller…", "models": ["Je voyage une fois tous les deux mois. J'aime aller à la mer.", "Pas très souvent, mais j'aime découvrir de nouveaux pays."] }
  ]
