    { "id": "l07.s.elle-prend-beaucoup-de-photos", "type": "sentence", "group": "À toi de parler", "fr": "Elle prend beaucoup de photos quand elle voyage.", "en": "She takes a lot of photos when she travels.", "frAlt": ["Quand elle voyage, elle prend beaucoup de photos.", "Elle prend beaucoup de photos en voyage."], "traps": ["prends", "des"], "grammar": "l07.g.present" },
