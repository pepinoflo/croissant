    { "id": "l07.v.depart", "type": "vocab", "group": "En voyage", "fr": "départ", "en": "departure", "pos": "noun", "gender": "m", "article": "le" },
    { "id": "l07.v.reservation", "type": "vocab", "group": "En voyage", "fr": "réservation", "en": "booking", "pos": "noun", "gender": "f", "enAlt": ["reservation"] },
