    { "id": "l03.s.moi-non-plus-cafe", "type": "sentence", "group": "À toi de parler", "fr": "— Je n'aime pas le café. — Moi non plus !", "en": "— I don't like coffee. — Me neither!", "frAlt": ["Je n'aime pas le café. Moi non plus !"], "traps": ["aussi", "du"] },
    { "id": "l03.s.tu-peux-repeter-lentement", "type": "sentence", "group": "À toi de parler", "fr": "Tu peux répéter plus lentement, s'il te plaît ?", "en": "Can you repeat more slowly, please?", "frAlt": ["Est-ce que tu peux répéter plus lentement, s'il te plaît ?", "Vous pouvez répéter plus lentement, s'il vous plaît ?", "Est-ce que vous pouvez répéter plus lentement, s'il vous plaît ?", "Pouvez-vous répéter plus lentement, s'il vous plaît ?"], "traps": ["peut", "lent"] },
    { "id": "l03.s.je-ne-trouve-pas-le-mot", "type": "sentence", "group": "À toi de parler", "fr": "Je ne trouve pas le mot, comment on dit ?", "en": "I can't find the word, how do you say it?", "frAlt": ["Je ne trouve pas le mot, [comment on dit|comment dit-on|comment est-ce qu'on dit] ?"], "traps": ["trouvé", "quoi"] },
    { "id": "l03.s.ca-depend-du-temps", "type": "sentence", "group": "À toi de parler", "fr": "Ça dépend du temps.", "en": "It depends on the weather.", "frAlt": ["Ça dépend de la météo.", "Cela dépend du temps."], "traps": ["de", "dépends"] },
