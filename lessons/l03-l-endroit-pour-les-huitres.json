    { "id": "l03.t.reagir-moi-aussi", "type": "transform", "group": "Transformer", "task": "Réagis : tu es du même avis.", "taskEn": "React: you feel the same way.", "from": "J'adore dessiner.", "fr": "Moi aussi !", "en": "Me too!", "frAlt": ["Moi aussi, j'adore dessiner !"] },
