    { "id": "l03.p.moi-non-plus", "type": "phrase", "group": "Réagir", "fr": "Moi non plus.", "en": "Me neither.", "note": "Used to agree with a negative sentence." },
    { "id": "l03.x.moi-non-plus", "type": "cloze", "group": "Réagir", "fr": "— Je n'aime pas le café. — Moi {{non plus}}.", "en": "— I don't like coffee. — Me neither.", "distractors": ["aussi", "pas", "oui"], "explain": "After a negative sentence: moi non plus." },
    { "id": "l03.x.moi-aussi", "type": "cloze", "group": "Réagir", "fr": "— J'adore la plage. — Moi {{aussi}} !", "en": "— I love the beach. — Me too!", "distractors": ["non plus", "pas", "si"], "explain": "After a positive sentence: moi aussi." },
