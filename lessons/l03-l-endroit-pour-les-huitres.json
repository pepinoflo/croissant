    { "id": "l03.s.je-dois-partir-cours", "type": "sentence", "group": "À toi de parler", "fr": "Je dois partir, j'ai un cours à quatorze heures.", "en": "I have to leave, I have a class at two.", "frAlt": ["Je dois partir, j'ai un cours à [quatorze heures|deux heures]."], "traps": ["doit", "est"] },
    { "id": "l03.s.boite-ronde-ou-carree", "type": "sentence", "group": "À toi de parler", "fr": "La boîte peut être ronde ou carrée.", "en": "The box can be round or square.", "hint": "the adjectives agree with « la boîte »", "traps": ["carré", "rond"] },
    { "id": "l03.s.gourde-avec-poignee", "type": "sentence", "group": "À toi de parler", "fr": "J'ai une grande gourde avec une poignée.", "en": "I have a big water bottle with a handle.", "traps": ["grand", "un"] },
    { "id": "l03.s.ferme-la-porte-a-cle", "type": "sentence", "group": "À toi de parler", "fr": "Tu peux fermer la porte à clé, s'il te plaît ?", "en": "Can you lock the door, please?", "frAlt": ["[Tu peux|Est-ce que tu peux] fermer la porte à clé, s'il te plaît ?", "[Vous pouvez|Pouvez-vous|Est-ce que vous pouvez] fermer la porte à clé, s'il vous plaît ?"], "traps": ["fermé", "le"] },
    { "id": "l03.s.je-ne-veux-pas-deranger", "type": "sentence", "group": "À toi de parler", "fr": "Je ne veux pas te déranger.", "en": "I don't want to disturb you.", "frAlt": ["Je ne veux pas [te|vous] déranger."], "traps": ["dérangé", "veut"] },
    { "id": "l03.s.je-me-souviens-de-cet-endroit", "type": "sentence", "group": "À toi de parler", "fr": "Je me souviens de cet endroit, c'était l'endroit pour les huîtres.", "en": "I remember this place, it was the place for oysters.", "hint": "se souvenir de", "traps": ["ce", "est"] },
