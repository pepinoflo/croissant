    { "id": "l03.p.bien-sur", "type": "phrase", "group": "Réagir", "fr": "Bien sûr.", "en": "Of course.", "scramble": false },
    { "id": "l03.p.d-accord", "type": "phrase", "group": "Réagir", "fr": "D'accord.", "en": "OK, all right.", "scramble": false },
    { "id": "l03.p.pas-de-probleme", "type": "phrase", "group": "Réagir", "fr": "Pas de problème.", "en": "No problem." },
    { "id": "l03.p.ca-marche", "type": "phrase", "group": "Réagir", "fr": "Ça marche.", "en": "That works for me.", "register": "informal", "enAlt": ["Sounds good."], "scramble": false },
    { "id": "l03.p.je-suis-d-accord", "type": "phrase", "group": "Réagir", "fr": "Je suis d'accord.", "en": "I agree." },
    { "id": "l03.p.je-ne-suis-pas-d-accord", "type": "phrase", "group": "Réagir", "fr": "Je ne suis pas d'accord.", "en": "I disagree.", "enAlt": ["I don't agree."] },

    { "id": "l03.p.comment-on-dit", "type": "phrase", "group": "Quand le mot ne vient pas", "fr": "Attends, comment on dit… ?", "en": "Wait, how do you say…?" },
    { "id": "l03.p.je-ne-trouve-pas-le-mot", "type": "phrase", "group": "Quand le mot ne vient pas", "fr": "Je ne trouve pas le mot.", "en": "I can't find the word." },
    { "id": "l03.p.comment-ca-s-appelle", "type": "phrase", "group": "Quand le mot ne vient pas", "fr": "Comment ça s'appelle, déjà ?", "en": "What's it called again?" },
    { "id": "l03.p.je-veux-dire-que", "type": "phrase", "group": "Quand le mot ne vient pas", "fr": "Je veux dire que…", "en": "I mean that…" },
    { "id": "l03.p.comment-expliquer", "type": "phrase", "group": "Quand le mot ne vient pas", "fr": "Je ne sais pas comment expliquer.", "en": "I don't know how to explain." },
    { "id": "l03.p.tu-peux-repeter", "type": "phrase", "group": "Quand le mot ne vient pas", "fr": "Tu peux répéter ?", "en": "Can you repeat that?" },
    { "id": "l03.p.plus-lentement", "type": "phrase", "group": "Quand le mot ne vient pas", "fr": "Tu peux parler plus lentement ?", "en": "Can you speak more slowly?" },

