  "order": 3,
  "title": "C'est l'endroit pour les huîtres",
  "titleEn": "Formal and informal questions, reacting, describing objects",
  "emoji": "🦪",
  "summary": "Asking the same question formally and informally, natural reactions (Ah bon ? Moi aussi !), what to say when a word escapes you, and describing an object so someone can guess it.",
  "items": [
    { "id": "l03.v.endroit", "type": "vocab", "group": "Pour commencer", "fr": "endroit", "en": "place", "pos": "noun", "gender": "m", "enAlt": ["spot"] },
    { "id": "l03.v.huitre", "type": "vocab", "group": "Pour commencer", "fr": "huître", "en": "oyster", "pos": "noun", "gender": "f", "emoji": "🦪" },
    { "id": "l03.p.endroit-pour-les-huitres", "type": "phrase", "group": "Pour commencer", "fr": "C'est l'endroit pour les huîtres.", "en": "It's the place for oysters." },
    { "id": "l03.v.se-souvenir", "type": "vocab", "group": "Pour commencer", "fr": "se souvenir", "en": "to remember", "pos": "verb", "example": { "fr": "Je me souviens.", "en": "I remember." } },

    { "id": "l03.g.registres", "type": "grammar", "title": "Formel et informel", "titleEn": "The same question at three levels",
      "body": "With friends, a rising voice is enough. **Est-ce que** works everywhere. **Inversion** is for formal speech and writing.\n\nWhen the verb ends in a vowel and the subject is il / elle / on, inversion adds **-t-** so it is easier to say: a-t-elle, va-t-il.",
      "table": { "headers": ["Informal", "Everyday", "Formal"], "rows": [
        ["Tu vas où ?", "Où est-ce que tu vas ?", "Où vas-tu ?"],
        ["Tu aimes le chocolat ?", "Est-ce que tu aimes le chocolat ?", "Aimes-tu le chocolat ?"],
        ["Il part en vacances ?", "Est-ce qu'il part en vacances ?", "Part-il en vacances ?"],
        ["Elle a un cours de maths ?", "Est-ce qu'elle a un cours de maths ?", "A-t-elle un cours de maths ?"]
      ] } },
    { "id": "l03.v.ecole", "type": "vocab", "group": "Formel et informel", "fr": "école", "en": "school", "pos": "noun", "gender": "f", "article": "l'", "emoji": "🏫" },
    { "id": "l03.p.tu-vas-a-l-ecole", "type": "phrase", "group": "Formel et informel", "fr": "Tu vas à l'école ?", "en": "Are you going to school? (informal)", "register": "informal" },
    { "id": "l03.p.ou-est-ce-que-tu-vas", "type": "phrase", "group": "Formel et informel", "fr": "Où est-ce que tu vas ?", "en": "Where are you going? (everyday)", "register": "neutral", "frAlt": ["Où vas-tu ?", "Tu vas où ?"], "enAlt": ["Where are you going?"] },
    { "id": "l03.p.je-ne-vais-pas-a-l-ecole", "type": "phrase", "group": "Formel et informel", "fr": "Je ne vais pas à l'école.", "en": "I'm not going to school." },
    { "id": "l03.p.aimes-tu-le-chocolat", "type": "phrase", "group": "Formel et informel", "fr": "Aimes-tu le chocolat ?", "en": "Do you like chocolate? (formal)", "register": "formal" },
    { "id": "l03.v.partir-en-vacances", "type": "vocab", "group": "Formel et informel", "fr": "partir en vacances", "en": "to go on holiday", "pos": "verb" },
    { "id": "l03.x.est-ce-qu-il", "type": "cloze", "group": "Formel et informel", "fr": "{{Est-ce qu'}}il part en vacances ?", "en": "Is he going on holiday?", "distractors": ["Est-ce que", "Qu'est-ce qu'", "Est-ce"], "choiceOnly": true, "grammar": "l03.g.registres", "explain": "que becomes qu' before a vowel: est-ce qu'il." },
    { "id": "l03.p.nous-allons-a-la-plage", "type": "phrase", "group": "Formel et informel", "fr": "Nous allons à la plage.", "en": "We are going to the beach." },
    { "id": "l03.v.cours", "type": "vocab", "group": "Formel et informel", "fr": "cours", "en": "class, lesson", "pos": "noun", "gender": "m", "example": { "fr": "Elle a un cours de maths.", "en": "She has a maths class." } },
    { "id": "l03.p.a-t-elle-un-cours", "type": "phrase", "group": "Formel et informel", "fr": "A-t-elle un cours de maths ?", "en": "Does she have a maths class? (formal)", "register": "formal" },
    { "id": "l03.x.a-t-elle", "type": "cloze", "group": "Formel et informel", "fr": "A{{-t-}}elle un cours de maths ?", "en": "Does she have a maths class?", "distractors": ["-", "-s-", "-l'"], "choiceOnly": true, "grammar": "l03.g.registres", "explain": "-t- is slipped in between two vowels: a-t-elle, a-t-il." },

