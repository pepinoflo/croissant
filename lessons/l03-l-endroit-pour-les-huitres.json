    { "id": "l03.p.je-ne-sais-pas-encore", "type": "phrase", "group": "Réagir", "fr": "Je ne sais pas encore.", "en": "I don't know yet." },
    { "id": "l03.p.ca-depend", "type": "phrase", "group": "Réagir", "fr": "Ça dépend.", "en": "It depends.", "scramble": false },
