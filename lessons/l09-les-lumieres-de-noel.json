      "forms": { "je": "aurai", "tu": "auras", "il": "aura", "nous": "aurons", "vous": "aurez", "ils": "auront" }, "note": "Stem: aur-" },
    { "id": "l09.c.aller-futur", "type": "conjugation", "group": "Les verbes irréguliers", "verb": "aller", "en": "to go", "tense": "futur simple", "grammar": "l09.g.futur-simple",
      "forms": { "je": "irai", "tu": "iras", "il": "ira", "nous": "irons", "vous": "irez", "ils": "iront" }, "note": "Stem: ir-" },
    { "id": "l09.c.faire-futur", "type": "conjugation", "group": "Les verbes irréguliers", "verb": "faire", "en": "to do, to make", "tense": "futur simple", "grammar": "l09.g.futur-simple",
      "forms": { "je": "ferai", "tu": "feras", "il": "fera", "nous": "ferons", "vous": "ferez", "ils": "feront" }, "note": "Stem: fer-" },
