    { "id": "l09.x.tu-finiras", "type": "cloze", "group": "S'entraîner", "fr": "Demain, tu {{finiras}} ton travail.", "en": "Tomorrow, you will finish your work.", "hint": "finir", "distractors": ["finira", "finirai", "finis"], "grammar": "l09.g.futur-simple" },
    { "id": "l09.x.elle-prendra", "type": "cloze", "group": "S'entraîner", "fr": "Elle {{prendra}} le train.", "en": "She will take the train.", "hint": "prendre", "distractors": ["prendera", "prendras", "prend"], "grammar": "l09.g.futur-simple" },
    { "id": "l09.x.nous-irons", "type": "cloze", "group": "S'entraîner", "fr": "Nous {{irons}} à Paris l'année prochaine.", "en": "We will go to Paris next year.", "hint": "aller", "distractors": ["allerons", "irez", "allons"], "grammar": "l09.g.futur-simple" },
    { "id": "l09.x.vous-serez", "type": "cloze", "group": "S'entraîner", "fr": "Vous {{serez}} contents du résultat.", "en": "You will be pleased with the result.", "hint": "être", "distractors": ["êtrez", "serons", "seront"], "grammar": "l09.g.futur-simple" },
    { "id": "l09.x.ils-auront", "type": "cloze", "group": "S'entraîner", "fr": "Ils {{auront}} une nouvelle maison.", "en": "They will have a new house.", "hint": "avoir", "distractors": ["avoiront", "aurons", "ont"], "grammar": "l09.g.futur-simple" },
