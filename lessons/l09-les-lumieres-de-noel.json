    { "id": "l09.c.pouvoir-futur", "type": "conjugation", "group": "Les verbes irréguliers", "verb": "pouvoir", "en": "to be able to", "tense": "futur simple", "grammar": "l09.g.futur-simple",
      "forms": { "je": "pourrai", "tu": "pourras", "il": "pourra", "nous": "pourrons", "vous": "pourrez", "ils": "pourront" }, "note": "Stem: pourr- (two r)" },
    { "id": "l09.v.vouloir", "type": "vocab", "group": "Les verbes irréguliers", "fr": "vouloir", "en": "to want", "pos": "verb" },
