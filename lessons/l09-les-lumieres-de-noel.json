    { "id": "l09.g.futur-simple", "type": "grammar", "title": "Le futur simple", "titleEn": "\"Will\": predictions, promises and distant plans",
      "body": "Take the **infinitive** and add the endings **-ai, -as, -a, -ons, -ez, -ont** (they look like the present of avoir).\n\nVerbs ending in **-re** drop the final e first: prendre → je prendrai, vendre → je vendrai, attendre → elle attendra.\n\nSome very common verbs have a special stem, but the endings never change.",
      "table": { "headers": ["", "parler", "Irregular stem", "Example"], "rows": [
        ["je", "parlerai", "être → ser-", "je serai"],
        ["tu", "parleras", "avoir → aur-", "tu auras"],
        ["il / elle / on", "parlera", "aller → ir-", "elle ira"],
        ["nous", "parlerons", "faire → fer-", "nous ferons"],
        ["vous", "parlerez", "venir → viendr-", "vous viendrez"],
        ["ils / elles", "parleront", "voir → verr-", "ils verront"],
        ["", "", "pouvoir → pourr-", "je pourrai"],
        ["", "", "vouloir → voudr-", "tu voudras"],
        ["", "", "devoir → devr-", "il devra"],
        ["", "", "savoir → saur-", "je saurai"]
      ] } },
    { "id": "l09.c.parler-futur", "type": "conjugation", "group": "Le futur simple", "verb": "parler", "en": "to speak", "tense": "futur simple", "grammar": "l09.g.futur-simple",
      "forms": { "je": "parlerai", "tu": "parleras", "il": "parlera", "nous": "parlerons", "vous": "parlerez", "ils": "parleront" } },
    { "id": "l09.c.prendre-futur", "type": "conjugation", "group": "Le futur simple", "verb": "prendre", "en": "to take", "tense": "futur simple", "grammar": "l09.g.futur-simple",
      "forms": { "je": "prendrai", "tu": "prendras", "il": "prendra", "nous": "prendrons", "vous": "prendrez", "ils": "prendront" },
      "note": "-re verbs drop the e: prendr + ai." },
    { "id": "l09.v.vendre", "type": "vocab", "group": "Le futur simple", "fr": "vendre", "en": "to sell", "pos": "verb", "note": "Future: je vendrai." },
    { "id": "l09.v.attendre", "type": "vocab", "group": "Le futur simple", "fr": "attendre", "en": "to wait", "pos": "verb", "note": "Future: elle attendra." },
    { "id": "l09.v.peindre", "type": "vocab", "group": "Le futur simple", "fr": "peindre", "en": "to paint", "pos": "verb", "emoji": "🎨", "note": "Future: je peindrai." },

    { "id": "l09.c.etre-futur", "type": "conjugation", "group": "Les verbes irréguliers", "verb": "être", "en": "to be", "tense": "futur simple", "grammar": "l09.g.futur-simple",
      "forms": { "je": "serai", "tu": "seras", "il": "sera", "nous": "serons", "vous": "serez", "ils": "seront" }, "note": "Stem: ser-" },
