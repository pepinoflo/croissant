    { "id": "l09.g.proche-ou-simple", "type": "grammar", "title": "Futur proche ou futur simple ?", "titleEn": "\"Going to\" or \"will\"?",
      "body": "**Futur proche** (je vais partir): soon, already decided, or you can see it coming.\n\n**Futur simple** (je partirai): further away, a prediction, a promise, or after **quand** when talking about the future.",
      "table": { "headers": ["Futur proche", "Futur simple"], "rows": [
        ["Je vais voyager demain.", "Je voyagerai un jour autour du monde."],
        ["Elle va appeler sa mère ce soir.", "Elle appellera sa mère quand elle aura le temps."],
        ["Nous allons déménager bientôt.", "Nous déménagerons peut-être dans dix ans."],
        ["Il va pleuvoir cet après-midi.", "Il pleuvra probablement demain."]
      ] } },
    { "id": "l09.p.les-voitures-voleront", "type": "phrase", "group": "Proche ou simple ?", "fr": "Dans cent ans, les voitures voleront.", "en": "In a hundred years, cars will fly." },
    { "id": "l09.p.avec-des-dragons", "type": "phrase", "group": "Proche ou simple ?", "fr": "Nous irons au travail avec des dragons.", "en": "We will go to work with dragons." },
    { "id": "l09.p.autour-du-monde", "type": "phrase", "group": "Proche ou simple ?", "fr": "Je voyagerai un jour autour du monde.", "en": "One day I will travel around the world." },
    { "id": "l09.p.elle-appellera-sa-mere", "type": "phrase", "group": "Proche ou simple ?", "fr": "Elle appellera sa mère quand elle aura le temps.", "en": "She will call her mother when she has time.", "note": "After quand, French uses the future where English uses the present." },
    { "id": "l09.p.nous-allons-demenager", "type": "phrase", "group": "Proche ou simple ?", "fr": "Nous allons déménager bientôt.", "en": "We are going to move soon." },
    { "id": "l09.p.il-va-pleuvoir", "type": "phrase", "group": "Proche ou simple ?", "fr": "Il va pleuvoir cet après-midi.", "en": "It's going to rain this afternoon." },
    { "id": "l09.p.il-pleuvra", "type": "phrase", "group": "Proche ou simple ?", "fr": "Il pleuvra probablement demain.", "en": "It will probably rain tomorrow." },
    { "id": "l09.v.nuage", "type": "vocab", "group": "Proche ou simple ?", "fr": "nuage", "en": "cloud", "pos": "noun", "gender": "m", "emoji": "☁️" },
    { "id": "l09.x.allons-partir", "type": "cloze", "group": "Proche ou simple ?", "fr": "Attention, le bus arrive ! Nous {{allons partir}} dans une minute.", "en": "Careful, the bus is coming! We are going to leave in a minute.", "hint": "partir", "distractors": ["partirons", "allons partons", "va partir"], "grammar": "l09.g.proche-ou-simple", "explain": "It is about to happen: futur proche." },
    { "id": "l09.x.elle-apprendra", "type": "cloze", "group": "Proche ou simple ?", "fr": "L'année prochaine, elle {{apprendra}} une nouvelle langue.", "en": "Next year, she will learn a new language.", "hint": "apprendre", "accept": ["va apprendre"], "distractors": ["apprendras", "apprendera", "apprend"], "grammar": "l09.g.proche-ou-simple", "explain": "Both work here: apprendra (some day next year) or va apprendre (it is already planned)." },
    { "id": "l09.x.vais-regarder-un-film", "type": "cloze", "group": "Proche ou simple ?", "fr": "Ce soir, je {{vais regarder}} un film avec mon copain. Nous avons déjà choisi le film.", "en": "Tonight I'm going to watch a film with my boyfriend. We have already chosen the film.", "hint": "regarder", "distractors": ["regarderai", "vais regarde", "va regarder"], "grammar": "l09.g.proche-ou-simple", "explain": "Already decided, and tonight: futur proche." },
    { "id": "l09.x.tu-parleras", "type": "cloze", "group": "Proche ou simple ?", "fr": "Un jour, tu {{parleras}} français très facilement.", "en": "One day, you will speak French very easily.", "hint": "parler", "distractors": ["parlera", "parles", "vas parle"], "grammar": "l09.g.proche-ou-simple", "explain": "\"Un jour\": distant and uncertain, so futur simple." },
    { "id": "l09.x.il-va-pleuvoir", "type": "cloze", "group": "Proche ou simple ?", "fr": "Regarde les nuages ! Il {{va pleuvoir}}.", "en": "Look at the clouds! It's going to rain.", "hint": "pleuvoir", "distractors": ["pleuvra", "va pleut", "vas pleuvoir"], "grammar": "l09.g.proche-ou-simple", "explain": "You can see it coming: futur proche." },
    { "id": "l09.x.les-voitures-seront", "type": "cloze", "group": "Proche ou simple ?", "fr": "Dans vingt ans, les voitures {{seront}} peut-être différentes.", "en": "In twenty years, cars will perhaps be different.", "hint": "être", "distractors": ["serons", "sera", "sont"], "grammar": "l09.g.proche-ou-simple" },
    { "id": "l09.x.allons-visiter-un-musee", "type": "cloze", "group": "Proche ou simple ?", "fr": "Demain, nous {{allons visiter}} un musée. Nous avons déjà acheté les billets.", "en": "Tomorrow we are going to visit a museum. We have already bought the tickets.", "hint": "visiter", "distractors": ["visiterons", "allons visitons", "vont visiter"], "grammar": "l09.g.proche-ou-simple", "explain": "The tickets are bought, the plan is fixed: futur proche." },
    { "id": "l09.x.deviendront", "type": "cloze", "group": "Proche ou simple ?", "fr": "Je pense que les voyages {{deviendront}} plus accessibles dans le futur.", "en": "I think travel will become more accessible in the future.", "hint": "devenir", "distractors": ["devenirons", "deviendra", "deviennent"], "grammar": "l09.g.proche-ou-simple", "explain": "devenir follows venir: deviendr-." },
    { "id": "l09.x.va-chercher", "type": "cloze", "group": "Proche ou simple ?", "fr": "Elle a décidé de changer de travail. Elle {{va chercher}} un nouvel emploi dès lundi.", "en": "She has decided to change jobs. She is going to look for a new job from Monday.", "hint": "chercher", "distractors": ["vas chercher", "va cherche", "vont chercher"], "grammar": "l09.g.proche-ou-simple" },
    { "id": "l09.x.tu-reussiras", "type": "cloze", "group": "Proche ou simple ?", "fr": "Je suis certaine que tu {{réussiras}} ton examen !", "en": "I'm sure you will pass your exam!", "hint": "réussir", "distractors": ["réussira", "réussirez", "réussir"], "grammar": "l09.g.proche-ou-simple" },

