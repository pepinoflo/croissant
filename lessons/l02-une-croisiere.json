    { "id": "l02.x.nous-couchons", "type": "cloze", "group": "Le soir", "fr": "Nous {{nous}} couchons tard.", "en": "We go to bed late.", "distractors": ["vous", "se", "me"] },
    { "id": "l02.x.se-levent", "type": "cloze", "group": "Le soir", "fr": "Ils {{se}} lèvent à sept heures.", "en": "They get up at seven o'clock.", "distractors": ["me", "te", "nous"] },

