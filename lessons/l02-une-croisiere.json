      "forms": { "je": "me couche", "tu": "te couches", "il": "se couche", "nous": "nous couchons", "vous": "vous couchez", "ils": "se couchent" },
      "note": "Reflexive verbs keep their little pronoun: me, te, se, nous, vous, se." },
