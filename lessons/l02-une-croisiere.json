  "title": "Une croisière",
  "titleEn": "Daily routine, questions and negation",
  "emoji": "🚢",
  "summary": "Describing your day from morning to night, the question words, three ways to ask a question, saying no with ne … pas, and the verbs être, avoir and aller.",
  "items": [
    { "id": "l02.v.croisiere", "type": "vocab", "group": "En voyage", "fr": "croisière", "en": "cruise", "pos": "noun", "gender": "f", "emoji": "🚢" },
    { "id": "l02.v.riviere", "type": "vocab", "group": "En voyage", "fr": "rivière", "en": "river", "pos": "noun", "gender": "f", "emoji": "🏞️" },
    { "id": "l02.v.plat", "type": "vocab", "group": "En voyage", "fr": "plat", "en": "dish", "pos": "noun", "gender": "m", "emoji": "🍲", "example": { "fr": "C'est un plat d'hiver.", "en": "It's a winter dish." } },
    { "id": "l02.v.hiver", "type": "vocab", "group": "En voyage", "fr": "hiver", "en": "winter", "pos": "noun", "gender": "m", "article": "l'", "emoji": "❄️", "note": "en hiver = in winter" },
    { "id": "l02.p.plat-d-hiver", "type": "phrase", "group": "En voyage", "fr": "C'est un plat d'hiver.", "en": "It's a winter dish.", "note": "de + hiver → d'hiver" },
    { "id": "l02.p.boeuf-et-patates", "type": "phrase", "group": "En voyage", "fr": "du bœuf et des patates", "en": "beef and potatoes", "note": "une patate is the everyday word for une pomme de terre." },
    { "id": "l02.g.elision", "type": "grammar", "title": "L'élision", "titleEn": "Dropping a vowel before a vowel",
      "body": "Short words ending in **e** (je, de, ne, le, me, te, se, que) lose it before a vowel or a silent h, and take an apostrophe instead.",
      "examples": [
        { "fr": "je + aime → j'aime", "en": "I like" },
        { "fr": "de + hiver → un plat d'hiver", "en": "a winter dish" },
        { "fr": "ne + aime → je n'aime pas", "en": "I don't like" }
      ] },

