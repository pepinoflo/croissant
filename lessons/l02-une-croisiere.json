    { "id": "l02.x.ou-vas-tu", "type": "cloze", "group": "Les mots interrogatifs", "fr": "{{Où}} vas-tu ? — À la plage.", "en": "Where are you going? — To the beach.", "distractors": ["Qui", "Quand", "Combien"] },
    { "id": "l02.x.avec-qui", "type": "cloze", "group": "Les mots interrogatifs", "fr": "Tu sors avec {{qui}} ? — Avec Marie.", "en": "Who are you going out with? — With Marie.", "distractors": ["quoi", "où", "quand"] },
    { "id": "l02.x.quand-pars-tu", "type": "cloze", "group": "Les mots interrogatifs", "fr": "{{Quand}} est-ce que tu pars ? — Demain matin.", "en": "When are you leaving? — Tomorrow morning.", "distractors": ["Où", "Qui", "Combien"] },
