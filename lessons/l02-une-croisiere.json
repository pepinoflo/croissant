    { "id": "l02.g.questions", "type": "grammar", "title": "La phrase interrogative", "titleEn": "Three ways to ask a question",
      "body": "The same question can be asked three ways. The words stay the same; only the form and the level of formality change.",
      "table": { "headers": ["How", "Example", "Register"], "rows": [
        ["Intonation (voice goes up)", "Tu aimes la danse ?", "informal"],
        ["Est-ce que + sentence", "Est-ce que tu aimes la danse ?", "everyday"],
        ["Inversion (verb-subject)", "Aimes-tu la danse ?", "formal"]
      ] } },
    { "id": "l02.p.ou-vas-tu", "type": "phrase", "group": "Poser une question", "fr": "Où vas-tu ?", "en": "Where are you going?", "register": "formal", "frAlt": ["Où allez-vous ?"], "note": "With vous: Où allez-vous ?" },
    { "id": "l02.v.plage", "type": "vocab", "group": "Poser une question", "fr": "plage", "en": "beach", "pos": "noun", "gender": "f", "emoji": "🏖️", "example": { "fr": "Je vais à la plage.", "en": "I'm going to the beach." } },
    { "id": "l02.p.tu-vas-manger-quoi", "type": "phrase", "group": "Poser une question", "fr": "Tu vas manger quoi ?", "en": "What are you going to eat? (informal)", "register": "informal", "frAlt": ["Qu'est-ce que tu vas manger ?", "Que vas-tu manger ?"], "enAlt": ["What are you going to eat?"] },
    { "id": "l02.p.qu-est-ce-que-tu-vas-manger", "type": "phrase", "group": "Poser une question", "fr": "Qu'est-ce que tu vas manger ?", "en": "What are you going to eat? (everyday)", "register": "neutral", "frAlt": ["Tu vas manger quoi ?", "Que vas-tu manger ?"], "enAlt": ["What are you going to eat?"] },
    { "id": "l02.p.que-vas-tu-manger", "type": "phrase", "group": "Poser une question", "fr": "Que vas-tu manger ?", "en": "What are you going to eat? (formal)", "register": "formal", "frAlt": ["Qu'est-ce que tu vas manger ?", "Tu vas manger quoi ?"], "enAlt": ["What are you going to eat?"] },
    { "id": "l02.p.je-vais-manger-du-chocolat", "type": "phrase", "group": "Poser une question", "fr": "Je vais manger du chocolat.", "en": "I'm going to eat some chocolate." },
    { "id": "l02.p.est-ce-que-tu-aimes", "type": "phrase", "group": "Poser une question", "fr": "Est-ce que tu aimes ce restaurant ?", "en": "Do you like this restaurant?" },
    { "id": "l02.p.aimes-tu-la-danse", "type": "phrase", "group": "Poser une question", "fr": "Aimes-tu la danse ?", "en": "Do you like dancing? (formal)", "register": "formal" },
    { "id": "l02.x.est-ce-que", "type": "cloze", "group": "Poser une question", "fr": "{{Est-ce que}} tu aimes la danse ?", "en": "Do you like dancing?", "distractors": ["Qu'est-ce que", "Quoi", "Combien"], "grammar": "l02.g.questions" },

    { "id": "l02.g.negation", "type": "grammar", "title": "La phrase négative", "titleEn": "Saying no: ne … pas",
      "body": "Put **ne** before the verb and **pas** after it.\n\nBefore a vowel or a silent h, **ne** becomes **n'**.\n\nAfter a negative, un / une / du / des usually become **de**.",
      "examples": [
        { "fr": "Je n'aime pas le café.", "en": "I don't like coffee." },
        { "fr": "Je ne fais pas de sport.", "en": "I don't do any sport." }
      ] },
    { "id": "l02.p.je-n-aime-pas", "type": "phrase", "group": "La négation", "fr": "Je n'aime pas le café.", "en": "I don't like coffee." },
    { "id": "l02.p.je-ne-fais-pas-de-sport", "type": "phrase", "group": "La négation", "fr": "Je ne fais pas de sport.", "en": "I don't do any sport." },
    { "id": "l02.x.pas", "type": "cloze", "group": "La négation", "fr": "Je n'aime {{pas}} le café.", "en": "I don't like coffee.", "distractors": ["ne", "non", "rien"], "grammar": "l02.g.negation" },
    { "id": "l02.x.n-allons-pas", "type": "cloze", "group": "La négation", "fr": "Nous {{n'}}allons pas à la plage.", "en": "We are not going to the beach.", "distractors": ["ne", "pas", "non"], "grammar": "l02.g.negation", "choiceOnly": true, "explain": "ne becomes n' before a vowel: n'allons." },
    { "id": "l02.x.pas-de-sport", "type": "cloze", "group": "La négation", "fr": "Je ne fais pas {{de}} sport.", "en": "I don't do any sport.", "distractors": ["du", "le", "un"], "grammar": "l02.g.negation", "explain": "After ne … pas, du becomes de." },

    { "id": "l02.c.aller-present", "type": "conjugation", "group": "Trois verbes essentiels", "verb": "aller", "en": "to go", "tense": "présent",
      "forms": { "je": "vais", "tu": "vas", "il": "va", "nous": "allons", "vous": "allez", "ils": "vont" } },
    { "id": "l02.c.etre-present", "type": "conjugation", "group": "Trois verbes essentiels", "verb": "être", "en": "to be", "tense": "présent",
      "forms": { "je": "suis", "tu": "es", "il": "est", "nous": "sommes", "vous": "êtes", "ils": "sont" } },
    { "id": "l02.c.avoir-present", "type": "conjugation", "group": "Trois verbes essentiels", "verb": "avoir", "en": "to have", "tense": "présent",
      "forms": { "je": "ai", "tu": "as", "il": "a", "nous": "avons", "vous": "avez", "ils": "ont" } }
  ]
